# .env.example -> .env 로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
# KIS 앱 키/시크릿은 계좌(종합계좌 8자리)마다 따로 발급됩니다.

# 모의투자 선물옵션 계좌 (주문 / 잔고 / 체결통보)
VPS_KIS_APP_KEY=
VPS_KIS_APP_SECRET=
VPS_KIS_ACCOUNT_NO=12345678-03

# 실전 계좌 키 (실시간 선물 시세 WebSocket - 실전 전용 TR_ID). 없으면 REST 폴링만 사용합니다.
PROD_KIS_APP_KEY=
PROD_KIS_APP_SECRET=

# KIS HTS ID (체결통보 H0IFCNI0 구독용). 없으면 체결통보 구독을 건너뜁니다.
KIS_HTS_ID=
